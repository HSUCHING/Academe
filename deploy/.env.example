# Domain and hosting
LEARNHOUSE_DOMAIN=academe.example.com
LEARNHOUSE_FRONTEND_DOMAIN=academe.example.com
LEARNHOUSE_SSL=true
LEARNHOUSE_PORT=9000
LEARNHOUSE_ALLOWED_ORIGINS=https://academe.example.com
LEARNHOUSE_TENANCY=single
LEARNHOUSE_DEVELOPMENT_MODE=false
LEARNHOUSE_LOGFIRE_ENABLED=false
LEARNHOUSE_SAAS=false
HOSTNAME=0.0.0.0
LEARNHOUSE_API_URL=http://localhost:9000

# Frontend runtime
NEXT_PUBLIC_LEARNHOUSE_API_URL=https://academe.example.com/api/v1/
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=https://academe.example.com/
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=academe.example.com
NEXT_PUBLIC_LEARNHOUSE_TOP_DOMAIN=example.com
NEXT_PUBLIC_LEARNHOUSE_MULTI_ORG=False
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=default
NEXT_PUBLIC_LEARNHOUSE_HTTPS=True
NEXT_PUBLIC_COLLAB_URL=wss://academe.example.com/collab
NEXTAUTH_URL=https://academe.example.com
NEXTAUTH_SECRET=replace-with-random-secret

# Database and Redis
POSTGRES_USER=learnhouse
POSTGRES_PASSWORD=replace-with-random-password
POSTGRES_DB=learnhouse
LEARNHOUSE_SQL_CONNECTION_STRING=postgresql://learnhouse:replace-with-random-password@postgres:5432/learnhouse
LEARNHOUSE_REDIS_CONNECTION_STRING=redis://redis:6379/0
LEARNHOUSE_REDIS_URL=redis://redis:6379/0

# Security and initial installation
LEARNHOUSE_AUTH_JWT_SECRET_KEY=replace-with-at-least-32-random-characters
COLLAB_INTERNAL_KEY=replace-with-random-shared-secret
LEARNHOUSE_INITIAL_ADMIN_EMAIL=admin@example.com
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=replace-with-initial-password
LEARNHOUSE_INITIAL_ORG_NAME=Default Organization
LEARNHOUSE_INITIAL_ORG_SLUG=default

# Optional Google OAuth
LEARNHOUSE_GOOGLE_OAUTH_CLIENT_ID=
LEARNHOUSE_GOOGLE_CLIENT_ID=
LEARNHOUSE_GOOGLE_CLIENT_SECRET=

# Optional Tinybird analytics
LEARNHOUSE_TINYBIRD_API_URL=
LEARNHOUSE_TINYBIRD_INGEST_TOKEN=
LEARNHOUSE_TINYBIRD_READ_TOKEN=

# AI
LEARNHOUSE_IS_AI_ENABLED=false
LEARNHOUSE_AI_PROVIDER=
LEARNHOUSE_AI_API_KEY=
LEARNHOUSE_AI_MODEL_FAST=
LEARNHOUSE_AI_MODEL_STANDARD=
LEARNHOUSE_AI_MODEL_PRO=
LEARNHOUSE_AI_EMBEDDING_PROVIDER=
LEARNHOUSE_AI_EMBEDDING_MODEL=
LEARNHOUSE_AI_EMBEDDING_DIMENSIONS=768

# Email
LEARNHOUSE_EMAIL_PROVIDER=resend
LEARNHOUSE_RESEND_API_KEY=
LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=notifications@example.com
LEARNHOUSE_SYSTEM_EMAIL_SENDER_NAME=Academe

# Content storage
LEARNHOUSE_CONTENT_DELIVERY_TYPE=filesystem
